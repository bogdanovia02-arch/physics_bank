[MASTER]
ignore=venv, migrations, tests

[FORMAT]
max-line-length=120

[MESSAGES CONTROL]
disable=missing-docstring,
        invalid-name,
        too-few-public-methods,
        unused-argument,
        no-member,
        import-error,
        broad-except,
        fixme,
        duplicate-code,
        C0115,
        C0116,
        R0903,
        R0913,
        W0621,
        W0613,
        R0801
